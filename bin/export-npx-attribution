#!/usr/bin/env node
'use strict';

// Export source attribution only. Never install, update or relink a skill.
const fs = require('fs');
const path = require('path');
const os = require('os');
const crypto = require('crypto');
const { spawnSync } = require('child_process');

const home = os.homedir();
const repo = path.resolve(__dirname, '..');
const manifest = JSON.parse(fs.readFileSync(path.join(repo, 'skills.lock.json'), 'utf8'));
const expand = (p) => p.startsWith('~/') ? path.join(home, p.slice(2)) : p;
const read = (p, fallback) => fs.existsSync(p) ? JSON.parse(fs.readFileSync(p, 'utf8')) : fallback;
const now = new Date().toISOString();

// Same content hash used by the npx skills project lock (not a Git tree SHA).
function folderHash(dir) {
  const files = [];
  function walk(current, prefix) {
    for (const item of fs.readdirSync(current, { withFileTypes: true })) {
      const relative = prefix ? `${prefix}/${item.name}` : item.name;
      const full = path.join(current, item.name);
      if (item.isDirectory() && !['.git', 'node_modules'].includes(item.name)) walk(full, relative);
      else if (item.isFile()) files.push([relative, full]);
    }
  }
  walk(dir, '');
  files.sort((a, b) => a[0].localeCompare(b[0]));
  const hash = crypto.createHash('sha256');
  for (const [relative, full] of files) hash.update(relative).update(fs.readFileSync(full));
  return hash.digest('hex');
}

function gitAttribution(dir) {
  const git = (args) => spawnSync('git', ['-C', fs.realpathSync(dir), ...args], { encoding: 'utf8' });
  const root = git(['rev-parse', '--show-toplevel']);
  if (root.status !== 0) return null;
  const remote = git(['remote', 'get-url', 'origin']);
  const url = remote.stdout?.trim();
  if (remote.status !== 0 || !/^https:\/\/github\.com\/[^/]+\/[^/]+$/.test(url)) return null;
  return {
    source: url.replace(/^https:\/\/github.com\//, '').replace(/\.git$/, ''),
    sourceType: 'github', sourceUrl: url,
    skillPath: path.relative(root.stdout.trim(), path.join(fs.realpathSync(dir), 'SKILL.md')),
    ref: git(['rev-parse', 'HEAD']).stdout.trim(),
  };
}

function attribution(skill, existing) {
  const entries = manifest.skills.filter((e) => e.name === skill.name);
  // A prior npx install can differ from the manager's pin. Keep its real record.
  if (existing?.source && !entries.some((e) => {
    const materialized = path.join(home, '.local/share/agent-config/skills', e.id || e.name);
    return fs.existsSync(materialized) && fs.realpathSync(skill.path) === fs.realpathSync(materialized);
  })) return existing;

  const e = entries[0];
  const origin = e?.url;
  const source = origin ? origin.replace(/^https:\/\/github.com\//, '').replace(/\.git$/, '') :
    e?.type === 'local' ? path.join(repo, e.path) :
    e?.type === 'app-bundled' ? expand(e.path) : skill.path;
  const entry = {
    source,
    sourceType: origin ? 'github' : 'local',
    sourceUrl: origin || source,
    skillPath: e?.include?.['SKILL.md'] || (e?.path && origin ? path.posix.join(e.path, 'SKILL.md') : 'SKILL.md'),
    ...(origin ? { ref: e.commit || e.branch || 'main' } : {}),
    // Do not invent an upstream tree hash for a patched or locally bundled copy.
    ...(e ? { agentConfig: {
      type: e.type, ids: entries.map((v) => v.id || v.name),
      ...(e.note ? { note: e.note } : {}),
      ...(e.patch ? { patch: e.patch } : {}),
      ...(e.overrides ? { overrides: e.overrides } : {}),
      ...(e.codexExplicitOnly ? { codexExplicitOnly: true } : {}),
      ...(e.appVersion ? { appVersion: e.appVersion } : {}),
    } } : { attributionNote: 'Local installation; upstream revision is not recorded.',
      ...(gitAttribution(skill.path) || {}),
      ...(manifest.attribution?.[skill.name] || {}),
    }),
  };
  if (origin) {
    const dir = path.join(home, '.local/share/agent-config/src', source.replace('/', '__'));
    const revision = e.commit || 'HEAD';
    const folder = path.posix.dirname(entry.skillPath);
    const result = spawnSync('git', ['-C', dir, 'rev-parse', folder === '.' ? `${revision}^{tree}` : `${revision}:${folder}`], { encoding: 'utf8' });
    if (result.status !== 0) throw new Error(`Cannot resolve source tree for ${skill.name}: ${result.stderr}`);
    entry.skillFolderHash = result.stdout.trim();
  }
  if (existing?.installedAt) entry.installedAt = existing.installedAt;
  if (existing?.updatedAt) entry.updatedAt = existing.updatedAt;
  return entry;
}

const fleet = path.join(home, 'Desktop/fleet');
for (const global of [true, false]) {
  if (!global && process.argv?.includes('--skip-desktop')) continue;
  const file = global ? path.join(home, '.agents/.skill-lock.json') : path.join(fleet, 'skills-lock.json');
  const lock = read(file, { version: global ? 3 : 1, skills: {} });
  let changed = 0;
  // Read installed directories directly; scheduled sync never downloads a CLI.
  const skills = [];
  const variants = {};
  // npx's universal Codex directory is ~/.agents/skills; Codex also loads
  // ~/.codex/skills. Include managed targets and those additional local skills.
  const dirs = new Set();
  for (const target of Object.values(manifest.targets)) {
    const dir = expand(typeof target === 'string' ? target : target.dir);
    if (process.argv?.includes('--skip-desktop') && dir.startsWith(path.join(home, 'Desktop') + '/')) continue;
    if (dir.startsWith(fleet + '/') !== global) dirs.add(dir);
  }
  for (const dir of dirs) {
    if (!fs.existsSync(dir)) continue;
    for (const name of fs.readdirSync(dir)) {
      if (name.startsWith('.')) continue;
      const skillPath = path.join(dir, name);
      if (!fs.existsSync(path.join(skillPath, 'SKILL.md'))) continue;
      const first = skills.find((s) => s.name === name);
      if (!first) skills.push({ name, path: skillPath });
      else if (fs.realpathSync(first.path) !== fs.realpathSync(skillPath)) {
        const origin = gitAttribution(skillPath);
        if (origin && origin.source !== attribution(first, lock.skills[name]).source) {
          (variants[name] ||= []).push({ path: skillPath, ...origin });
        }
      }
    }
  }
  if (JSON.stringify(lock.attributionVariants || {}) !== JSON.stringify(variants)) {
    lock.attributionVariants = variants;
    changed++;
  }
  for (const skill of skills) {
    const before = lock.skills[skill.name];
    const next = { ...attribution(skill, before) };
    if (!global) next.computedHash = folderHash(skill.path);
    if (JSON.stringify(next) === JSON.stringify(before)) continue;
    lock.skills[skill.name] = global ? {
      ...next, installedAt: before?.installedAt || now, updatedAt: now,
    } : next;
    changed++;
  }
  if (changed) {
    const backup = path.join(home, '.agent-config-backups', now.slice(0, 10), 'npx-attribution');
    fs.mkdirSync(backup, { recursive: true });
    if (fs.existsSync(file)) fs.copyFileSync(file, path.join(backup, `${global ? 'global' : 'fleet'}-${Date.now()}.json`));
    fs.writeFileSync(file, JSON.stringify(lock, null, 2) + '\n');
  }
  console.log(`${global ? 'global' : 'fleet'}: ${skills.length} skills attributed, ${changed} records updated`);
}
