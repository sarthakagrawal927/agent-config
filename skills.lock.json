      "include": {
        "SKILL.md": "skills/cardboard/SKILL.md",
        "commands": "commands",
        "techniques": "techniques"
      },
      "overrides": {
        "description": "Edit Cardboard video projects (.cardboard bundles) with the `cb` CLI and timeline.tsx: cut, arrange, caption, add titles and motion graphics, generate footage, narration, music or sound effects, import video links, and check the result with cb look. Use when a task mentions Cardboard or `cb`, or a .cardboard folder or timeline.tsx is in view.",
        "disable-model-invocation": true
      },
      "targets": [
        "agents",
        "claude",
        "codex"
      ],
      "note": "Exception: ships only inside Cardboard.app (no public repo). Rebuilt from the app on every sync."
